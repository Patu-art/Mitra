{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mitra.local/schemas/capability-result.schema.json",
  "title": "Mitra Capability Result",
  "description": "A truthful result returned by a platform capability adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "status", "message", "completed_at"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "denied", "needs_confirmation", "unsupported", "failed"]
    },
    "message": {
      "type": "string",
      "maxLength": 500
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_code": {
      "type": "string",
      "maxLength": 80
    }
  }
}
